# 复制为 .env。已在进程里的变量不会被覆盖。
# 系统超级管理员：只有这个账号能安装、卸载、改内置插件内容。
BIU_SUPER_ADMIN_EMAIL=97@biu.com
BIU_SUPER_ADMIN_PASSWORD=123456

# 线上 / 本机。`npm run dev` 里的 PORT、BIU_HOME、BIU_ONLINE 会覆盖这里。
BIU_ONLINE=1
PORT=3141
HTTP_HOST=0.0.0.0
BIU_HOME=.cloud-data
BIU_WEB_PORT=5173
BIU_API_PORT=3141

# 插件目录
# BIU_PLUGIN_DIR=
# BIU_PLUGIN_DEV_DIR=
# BIU_PLUGIN_STATE=

# 工作区与档案
# CORDIS_WORKSPACE=
# CORDIS_SESSION_STORE=
# BIU_PROFILE=
# BIU_SKILL_ROOT=
# BIU_SKILLS_DIR=

# 远程与分享
# BIU_REMOTE_ORIGIN=
# SHARE_PROXY_UI=
# SHARE_PORT=
# SHARE_PUBLIC_URL=

# Electron / 开发
# BIU_DEV_URL=http://127.0.0.1:5173
# BIU_HOST_URL=
# BIU_ELECTRON_DEV=
# BIU_ELECTRON_CDP_PORT=

# 模型
# CHAT_MODEL=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CTX_BUDGET=

# 更新与检索
# BIU_UPDATE_REMOTE=
# BIU_UPDATE_REF=
# BIU_WEB_SEARCH_PROVIDER=
# BIU_WEB_FETCH_PROVIDER=
