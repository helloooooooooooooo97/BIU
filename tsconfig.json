{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "web",
    "host",
    "packages"
  ],
  "exclude": [
    ".plugin-dev",
    ".plugin",
    "node_modules",
    "dist",
    "pack-host",
    "release"
  ]
}